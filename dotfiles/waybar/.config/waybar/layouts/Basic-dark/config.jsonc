{
  "position": "${WAYBAR_POSITION}",
  "margin-top": ${WAYBAR_MARGIN_TOP},
  "modules-left": [
    "clock",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "tray"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "custom/notification"
  ],
  "clock": {
    "interval": ${CLOCK_INTERVAL},
    "format": "${CLOCK_FORMAT}",
    "max-length": ${CLOCK_MAX_LENGTH}
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": ${PERSISTENT_WORKSPACES_DEFAULT}, // workspaces by default on every monitor
      "${WORKSPACES_MONITOR_NAME}": ${PERSISTENT_WORKSPACES_PER_MONITOR} // override on this monitor
    }
  },
  "tray": {
    "icon-size": ${TRAY_ICON_SIZE},
    "spacing": ${TRAY_SPACING},
    "icons": {
      "blueman": "bluetooth",
      "TelegramDesktop": "${TELEGRAM_ICON_PATH}"
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        ""
      ]
    },
    "scroll-step": ${PULSEAUDIO_SCROLL_STEP},
    "on-click": "${PULSEAUDIO_ON_CLICK}",
    "ignored-sinks": [
      "${PULSEAUDIO_IGNORED_SINK}"
    ]
  },
  "network": {
    "interface": "${NETWORK_INTERFACE}",
    "format": "{ifname}",
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    "format-disconnected": "", // An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": ${NETWORK_MAX_LENGTH},
    "on-click": "kitty -e nmtui"
  },
  "battery": {
    "bat": "${BATTERY_NAME}",
    "interval": ${BATTERY_INTERVAL},
    "states": {
      "warning": ${BATTERY_WARN},
      "critical": ${BATTERY_CRIT}
    },
    "format": "{capacity}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "max-length": ${BATTERY_MAX_LENGTH}
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='16pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
