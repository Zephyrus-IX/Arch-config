# layout basics
WAYBAR_POSITION=top
WAYBAR_MARGIN_TOP=0

# clock
CLOCK_INTERVAL=60
CLOCK_FORMAT="{:%I:%M}"
CLOCK_MAX_LENGTH=25

# workspaces
PERSISTENT_WORKSPACES_DEFAULT=5
WORKSPACES_MONITOR_NAME=HDMI-A-1
PERSISTENT_WORKSPACES_PER_MONITOR=3

# tray
TRAY_ICON_SIZE=21
TRAY_SPACING=10
TELEGRAM_ICON_PATH=$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png

# pulseaudio
PULSEAUDIO_SCROLL_STEP=1
PULSEAUDIO_ON_CLICK=pavucontrol
PULSEAUDIO_IGNORED_SINK="Easy Effects Sink"

# network
NETWORK_INTERFACE=wlp5s0
NETWORK_MAX_LENGTH=50

# battery
BATTERY_NAME=BAT0
BATTERY_INTERVAL=60
BATTERY_WARN=30
BATTERY_CRIT=15
BATTERY_MAX_LENGTH=25
